{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=MicroserviceTemplateDb;Username=postgres;Password=password"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Formatting.Compact" ],
    "MinimumLevel": "Information",
    "Override": {
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": [ "*" ],
  "Authentication": {
    "ValidIssuer": "https://microservice-template.us.auth0.com/",
    "ValidAudience": "testAPI"
  },
  "GitHaubClient": {
    "Name": "GitHaub",
    "Audience": "testAPI",
    "BaseUrl": "https://localhost:5001",
    "TokenEndpointUrl": "https://microservice-template.us.auth0.com/oauth/token",
    "ClientId": "3AaHQ8NeRXEBk1pDydvuTBj8dqv5X0RA",
    "ClientSecret": "GSZf5dRgO2hhOSZ1ooiKTwTx5p6IX6v6UWKTm1Qm7TAsBi45BHT-4fAOO4d2bkBv"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Outbox": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetries": 5
  },
  "DefaultPolicy": {
    "Retry": {
      "Read": {
        "IntervalsMs": [ 100, 500 ],
        "HttpStatusCodes": [ "BadGateway", "ServiceUnavailable", "GatewayTimeout" ]
      },
      "Write": {
        "IntervalsMs": [ 100, 500 ],
        "HttpStatusCodes": [ "BadGateway", "ServiceUnavailable", "GatewayTimeout" ]
      }
    },
    "RequestTimeoutMs": 60000,
    "CircuitBreaker": {
      "DurationOfBreakMs": 30000,
      "ExceptionsAllowedBeforeBreaking": 12
    },
    "Bulkhead": {
      "maxParallelization": 10,
      "maxQueuingActions": 2
    }
  }
}
